# VagaMatch - Arquivo de configuração
# Copie para .env e preencha suas chaves

# Chave da API SerpAPI (gratuita - 100 buscas/mês)
# Obtenha em: https://serpapi.com
SERPAPI_KEY=sk_sua_chave_aqui

# Chave da API Jooble (gratuita)
# Obtenha em: https://jooble.org/api/about
JOOBLE_API_KEY=sua_chave_jooble_aqui

# Chave da API RapidAPI (gratuita - 500 requests/dia)
# Obtenha em: https://rapidapi.com
RAPIDAPI_KEY=sua_chave_rapidapi_aqui

# (Opcional) Modo de desenvolvimento
DEBUG=true
